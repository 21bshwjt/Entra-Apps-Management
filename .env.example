# Entra ID app registration for THIS portal
TENANT_ID=00000000-0000-0000-0000-000000000000
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=replace-me

# Must exactly match a Web redirect URI on the app registration
REDIRECT_URI=http://localhost:3000/auth/callback
POST_LOGOUT_REDIRECT_URI=http://localhost:3000/

PORT=3000
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-long-random-string

# Max secret lifetime offered to users (months)
MAX_SECRET_MONTHS=24

# ---- Expiry e-mails to app owners (optional, see README "Step 4") ----
# Turn on daily reminders sent by the portal itself (no external scheduler needed)
NOTIFY_ENABLED=false
# Shared mailbox the e-mails are sent from (Exchange Online)
NOTIFY_SENDER=entra-app-alerts@yourdomain.com
# E-mail daily from this many days before a secret/certificate expires
NOTIFY_DAYS_BEFORE=30
# After expiry, e-mail every this many days until the credential is deleted
NOTIFY_EXPIRED_EVERY_DAYS=7
# Hour of the day (0-23, server time) when the daily check runs
NOTIFY_HOUR=8
# Link used in the e-mail. Leave empty to use the address from REDIRECT_URI
PORTAL_URL=
# Where the "last e-mailed" record is kept (default: data/notify-state.json)
# NOTIFY_STATE_FILE=/home/data/notify-state.json
